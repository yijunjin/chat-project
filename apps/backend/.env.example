# LLM providers
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Blizzard API
BLIZZARD_CLIENT_ID=your_blizzard_client_id
BLIZZARD_CLIENT_SECRET=your_blizzard_client_secret

# Hearthstone log watcher
# Path to the Hearthstone logs root directory (contains timestamped session folders)
HS_LOG_PATH=F:\Hearthstone\Logs
# Your Battle.net display name (exactly as shown in Power.log PlayerName field)
HS_PLAYER_NAME=易君#5408

# Server
PORT=3000
